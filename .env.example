DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/aiworkpay?schema=public"
AUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
ADMIN_EMAILS="admin@example.com"

STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Agent API rate limits (optional, defaults shown)
# RATE_LIMIT_AGENT_PER_MINUTE=120
# RATE_LIMIT_CREATIONS_PER_HOUR=30
# RATE_LIMIT_AUTH_FAILURES_PER_10_MIN=20
# Set to false when the app is NOT behind a reverse proxy setting X-Forwarded-For
# TRUST_PROXY=true

# Proof files: "local" (development, UPLOAD_DIR) or "s3" (any S3-compatible service)
STORAGE_DRIVER="local"
# UPLOAD_DIR="./uploads"
# S3_BUCKET="aiworkpay-proofs"
# S3_REGION="eu-west-3"
# S3_ENDPOINT=""            # e.g. https://<account>.r2.cloudflarestorage.com, https://s3.fr-par.scw.cloud
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# S3_FORCE_PATH_STYLE="false"  # true for MinIO
# PROOF_MAX_FILE_MB=10
# PROOF_MAX_FILES=20

RESEND_API_KEY="re_..."
EMAIL_FROM="Aiworkpay <noreply@your-domain.example>"
CONTACT_EMAIL="contact@your-domain.example"

# Optional OAuth providers. Buttons only appear when both values are set.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
APPLE_CLIENT_ID=""
APPLE_CLIENT_SECRET=""
FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""
