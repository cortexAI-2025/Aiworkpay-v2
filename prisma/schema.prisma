generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PAYWORKER
  ADMIN
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

enum MissionStatus {
  PAYMENT_PENDING
  CREATED
  PUBLISHED
  ASSIGNED
  IN_PROGRESS
  DELIVERED
  COMPLETED
  CANCELED
}

enum TransactionType {
  AGENT_PAYMENT
  PAYWORKER_PAYOUT
  PLATFORM_FEE
  // legacy
  SUBSCRIPTION
  MISSION_PAYOUT
}

enum TransactionStatus {
  PENDING
  SUCCEEDED
  FAILED
}

enum SubscriptionStatus {
  ACTIVE
  INACTIVE
  CANCELED
}

// ─── NextAuth models ─────────────────────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── App models ───────────────────────────────────────────────────────────────

model User {
  id            String    @id @default(uuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?   // null for OAuth users
  phone         String?   @unique
  phoneVerified Boolean   @default(false)
  role          Role      @default(PAYWORKER)

  // Stripe Connect: payout account for Payworkers
  stripeAccountId        String?
  stripeAccountOnboarded Boolean @default(false)

  // Legacy customer ID (may be set if user ever pays something)
  stripeCustomerId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts         Account[]
  sessions         Session[]
  apiKeys          ApiKey[]
  missionsCreated  Mission[]     @relation("MissionCreatedByUser")
  missionsAssigned Mission[]     @relation("MissionAssignedTo")
  transactions     Transaction[]
}

model ApiKey {
  id    String  @id @default(uuid())
  key   String  @unique
  label String
  active Boolean @default(true)

  // Stripe: each agent (API key) has a Stripe customer for billing
  stripeCustomerId String?

  createdAt DateTime @default(now())

  createdByUserId String?
  createdBy       User?    @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  missions Mission[]
}

model Mission {
  id          String        @id @default(uuid())
  title       String
  description String
  budget      Decimal       @db.Decimal(10, 2)
  currency    String        @default("EUR")
  deadline    DateTime
  priority    Priority      @default(MEDIUM)
  status      MissionStatus @default(CREATED)

  // Payment tracking (agent pays upfront)
  stripePaymentIntentId String?

  // Commission stored at time of completion
  platformFeeAmount Decimal? @db.Decimal(10, 2) // 10 %
  payworkerAmount   Decimal? @db.Decimal(10, 2) // 90 %

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdByApiKeyId String?
  createdByApiKey   ApiKey?  @relation(fields: [createdByApiKeyId], references: [id], onDelete: SetNull)

  createdByUserId String?
  createdByUser   User?    @relation("MissionCreatedByUser", fields: [createdByUserId], references: [id], onDelete: SetNull)

  assignedToUserId String?
  assignedTo       User?    @relation("MissionAssignedTo", fields: [assignedToUserId], references: [id], onDelete: SetNull)

  attachments  MissionAttachment[]
  transactions Transaction[]
}

model MissionAttachment {
  id        String   @id @default(uuid())
  url       String
  filename  String
  mimeType  String?
  size      Int?
  createdAt DateTime @default(now())

  missionId String
  mission   Mission  @relation(fields: [missionId], references: [id], onDelete: Cascade)
}

model Transaction {
  id                    String            @id @default(uuid())
  amount                Decimal           @db.Decimal(10, 2)
  currency              String            @default("EUR")
  type                  TransactionType
  status                TransactionStatus @default(PENDING)
  stripePaymentIntentId String?
  stripeChargeId        String?
  stripeTransferId      String?
  createdAt             DateTime          @default(now())

  missionId String?
  mission   Mission? @relation(fields: [missionId], references: [id], onDelete: SetNull)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}
