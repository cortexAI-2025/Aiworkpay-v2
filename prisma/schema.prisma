generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PAYWORKER
  ADMIN
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

enum MissionStatus {
  PAYMENT_PENDING
  CREATED
  PUBLISHED
  ASSIGNED
  IN_PROGRESS
  DELIVERED
  COMPLETED
  CANCELED
}

enum ScanStatus {
  CLEAN // scanned by ClamAV, no threat found
  NOT_SCANNED // stored while scanning was turned off (ANTIVIRUS=off)
}

enum AttachmentKind {
  BRIEF // provided with the mission
  PROOF // delivered by the Payworker as proof of work
}

enum TransactionType {
  AGENT_PAYMENT
  PAYWORKER_PAYOUT
  PLATFORM_FEE
  // legacy
  SUBSCRIPTION
  MISSION_PAYOUT
}

enum TransactionStatus {
  PENDING
  SUCCEEDED
  FAILED
}

enum SubscriptionStatus {
  ACTIVE
  INACTIVE
  CANCELED
}

// ─── NextAuth models ─────────────────────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expires   DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─── App models ───────────────────────────────────────────────────────────────

model User {
  id            String    @id @default(uuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String? // null for OAuth users
  phone         String?   @unique
  phoneVerified Boolean   @default(false)
  role          Role      @default(PAYWORKER)

  // Stripe Connect: payout account for Payworkers
  stripeAccountId        String?
  stripeAccountOnboarded Boolean @default(false)

  // Legacy customer ID (may be set if user ever pays something)
  stripeCustomerId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts            Account[]
  sessions            Session[]
  apiKeys             ApiKey[]
  missionsCreated     Mission[]            @relation("MissionCreatedByUser")
  missionsAssigned    Mission[]            @relation("MissionAssignedTo")
  transactions        Transaction[]
  passwordResetTokens PasswordResetToken[]
}

model ApiKey {
  id        String  @id @default(uuid())
  // SHA-256 of the key: the key itself is shown once at creation, never stored
  keyHash   String  @unique
  // First characters of the key (awp_xxxxxxxx), to recognise it in the dashboard
  keyPrefix String
  label     String
  active    Boolean @default(true)

  // What the key may do: missions:read, missions:write, missions:approve
  scopes     String[]  @default(["missions:read", "missions:write", "missions:approve"])
  expiresAt  DateTime?
  lastUsedAt DateTime?

  // Spending caps, in the missions' currency (null = no cap)
  maxMissionBudget Decimal? @db.Decimal(10, 2)
  monthlyBudget    Decimal? @db.Decimal(10, 2)

  // Stripe: each agent (API key) has a Stripe customer for billing
  stripeCustomerId String?

  createdAt DateTime @default(now())

  createdByUserId String?
  createdBy       User?   @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  missions Mission[]
}

model Mission {
  id          String        @id @default(uuid())
  title       String
  description String
  budget      Decimal       @db.Decimal(10, 2)
  currency    String        @default("EUR")
  deadline    DateTime
  priority    Priority      @default(MEDIUM)
  status      MissionStatus @default(CREATED)

  // Payment tracking (agent pays upfront)
  stripePaymentIntentId String?

  // Hosted Stripe Checkout page, when the mission is paid by a human through a link
  stripeCheckoutSessionId String?   @unique
  checkoutUrl             String?
  checkoutExpiresAt       DateTime?

  // Idempotency-Key sent by the agent: a retried creation returns the same mission
  idempotencyKey         String?
  idempotencyFingerprint String?

  // Result delivered by the Payworker
  resultNote  String?
  resultData  Json?
  deliveredAt DateTime?

  // Changes requested by the agent on a delivery (DELIVERED → IN_PROGRESS)
  revisionFeedback String?
  revisionCount    Int     @default(0)

  // Commission stored at time of completion
  platformFeeAmount Decimal? @db.Decimal(10, 2) // 10 %
  payworkerAmount   Decimal? @db.Decimal(10, 2) // 90 %

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdByApiKeyId String?
  createdByApiKey   ApiKey? @relation(fields: [createdByApiKeyId], references: [id], onDelete: SetNull)

  createdByUserId String?
  createdByUser   User?   @relation("MissionCreatedByUser", fields: [createdByUserId], references: [id], onDelete: SetNull)

  assignedToUserId String?
  assignedTo       User?   @relation("MissionAssignedTo", fields: [assignedToUserId], references: [id], onDelete: SetNull)

  attachments  MissionAttachment[]
  transactions Transaction[]

  @@unique([createdByApiKeyId, idempotencyKey])
}

model MissionAttachment {
  id           String         @id @default(uuid())
  url          String
  filename     String
  mimeType     String?
  size         Int?
  kind         AttachmentKind @default(BRIEF)
  // Set for a file uploaded to private storage (served by the app after an
  // access check); null for an external link
  storageKey   String?        @unique
  uploadedById String?
  // Antivirus result for an uploaded file (null for an external link)
  scanStatus   ScanStatus?
  scannedAt    DateTime?
  createdAt    DateTime       @default(now())

  missionId String
  mission   Mission @relation(fields: [missionId], references: [id], onDelete: Cascade)
}

model Transaction {
  id                    String            @id @default(uuid())
  amount                Decimal           @db.Decimal(10, 2)
  currency              String            @default("EUR")
  type                  TransactionType
  status                TransactionStatus @default(PENDING)
  stripePaymentIntentId String?
  stripeChargeId        String?
  stripeTransferId      String?
  createdAt             DateTime          @default(now())

  missionId String?
  mission   Mission? @relation(fields: [missionId], references: [id], onDelete: SetNull)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Fixed-window counters shared by every instance of the app (rate limiting)
model RateLimitBucket {
  id        String   @id // "<bucket>:<window index>"
  count     Int      @default(0)
  expiresAt DateTime

  @@index([expiresAt])
}
